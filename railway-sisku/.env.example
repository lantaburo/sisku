NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://sisku:sisku@127.0.0.1:5432/sisku
# Aktifkan hanya bila PostgreSQL eksternal memang mewajibkan TLS.
DATABASE_SSL=false

# Untuk sinkronisasi read-only dari Google Sheets (jangan commit nilai aslinya).
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Opsional: nama sekolah sebelum snapshot pertama diimpor.
APP_NAME=SISKU
